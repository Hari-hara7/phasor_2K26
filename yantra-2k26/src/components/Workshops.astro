---
import { site } from "../data/site.js";

const icons: Record<string, string> = {
  drone:
    "M35 35 L18 18 M35 35 L52 18 M35 35 L18 52 M35 35 L52 52 M18 18 C12 12 26 12 18 18 M52 18 C44 12 58 12 52 18 M18 52 C12 58 26 58 18 52 M52 52 C44 58 58 58 52 52 M28 35 H42",
  grid:
    "M35 10 L20 58 M35 10 L50 58 M25 42 H45 M20 58 H50 M12 24 H58 M12 24 L12 58 M58 24 L58 58 M35 24 V58",
  career:
    "M16 52 H54 M20 52 C22 38 30 30 42 24 M42 24 H30 M42 24 V36 M26 18 C26 12 44 12 44 18 C44 24 26 24 26 18",
};
---

<section id="workshops" class="section">
  <div class="wrap">
    <div class="section-head">
      <span class="eyebrow">Hands-on tracks</span>
      <h2>Workshops</h2>
      <p>Electrical innovation tracks covering embedded intelligence, renewable grids, and career direction.</p>
    </div>

    <div class="w-grid">
      {site.workshops.map((w, i) => (
        <article class="w-card">
          <div class="w-top">
            <span class="w-index">{String(i + 1).padStart(2, "0")}</span>
            <svg viewBox="0 0 70 70" width="52" height="52" class="w-icon">
              <path d={icons[w.icon]} fill="none" stroke="var(--teal)" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" />
            </svg>
          </div>
          <span class="w-tag">{w.tag}</span>
          <h3>{w.title}</h3>
          <p>{w.desc}</p>
          <p class="speaker">{w.speaker}</p>
        </article>
      ))}
    </div>

    <p class="venue">Venue: {site.venue}</p>
  </div>
</section>

<style>
  .w-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .w-card {
    background:
      linear-gradient(180deg, rgba(0, 194, 255, 0.08), transparent 42%),
      var(--bg-panel);
    padding: 32px;
    transition: background 0.2s ease, box-shadow 0.2s ease;
  }
  .w-card:hover {
    background: var(--bg-panel-2);
    box-shadow: inset 0 0 0 1px rgba(0, 194, 255, 0.28);
  }
  .w-top {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    margin-bottom: 28px;
  }
  .w-index {
    font-family: var(--font-mono);
    color: var(--text-faint);
    font-size: 0.85rem;
  }
  .w-icon {
    filter: drop-shadow(0 0 12px rgba(0, 194, 255, 0.35));
  }
  .w-tag {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--gold);
    margin-bottom: 10px;
  }
  .w-card h3 {
    font-size: 1.35rem;
    margin-bottom: 12px;
  }
  .w-card p {
    color: var(--text-muted);
    font-size: 0.92rem;
  }
  .speaker {
    margin-top: 18px;
    color: var(--text) !important;
    font-family: var(--font-mono);
    font-size: 0.78rem !important;
  }
  .venue {
    margin-top: 28px;
    color: var(--teal);
    font-family: var(--font-mono);
    font-size: 0.9rem;
  }

  @media (max-width: 860px) {
    .w-grid { grid-template-columns: 1fr; }
  }
</style>
