---
import { site } from "../data/site.js";
---

<section id="about" class="section">
  <div class="wrap about-grid">
    <div class="section-head no-max">
      <span class="eyebrow">About the symposium</span>
      <h2>Where ideas flow without resistance.</h2>
      <div class="body-copy">
        {site.about.map((p) => (
          <p>{p}</p>
        ))}
      </div>
    </div>

    <ul class="meta-list">
      {site.aboutMeta.map((m) => (
        <li>
          <span class="meta-label">{m.label}</span>
          <span class="meta-value">{m.value}</span>
        </li>
      ))}
    </ul>
  </div>
</section>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 56px;
    align-items: start;
  }
  .no-max { max-width: none; margin-bottom: 0; }
  .about-grid h2 {
    font-size: clamp(2rem, 4vw, 2.6rem);
    margin-top: 14px;
    margin-bottom: 26px;
    max-width: 480px;
  }
  .body-copy {
    display: flex;
    flex-direction: column;
    gap: 18px;
    color: var(--text-muted);
    max-width: 560px;
    font-size: 1rem;
  }

  .meta-list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--line);
  }
  .meta-list li {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 20px 0;
    border-bottom: 1px solid var(--line);
  }
  .meta-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--teal);
  }
  .meta-value {
    font-size: 0.98rem;
    color: var(--text);
  }

  @media (max-width: 860px) {
    .about-grid { grid-template-columns: 1fr; gap: 32px; }
  }
</style>
