---
import { site } from "../data/site.js";

const links = [
  { href: "#about", label: "About" },
  { href: "#workshops", label: "Workshops" },
  { href: "#events", label: "Events" },
  { href: "#department", label: "Department" },
  { href: "#team", label: "Team" },
];
---

<header class="nav">
  <div class="wrap nav-inner">
    <a href="#top" class="brand">
      <span class="brand-mark">Y</span>
      <span class="brand-text">
        YANTRA<span class="brand-year">2K26</span>
      </span>
    </a>

    <nav class="links" aria-label="Primary">
      {links.map((l) => (
        <a href={l.href}>{l.label}</a>
      ))}
    </nav>

    <a class="btn btn-primary nav-cta" href={site.registerUrl} target="_blank" rel="noopener noreferrer">
      Register
    </a>

    <button class="burger" id="burger" aria-label="Open menu" aria-expanded="false">
      <span></span><span></span><span></span>
    </button>
  </div>

  <nav class="mobile-links" id="mobile-links" aria-label="Mobile">
    {links.map((l) => (
      <a href={l.href}>{l.label}</a>
    ))}
    <a class="btn btn-primary" href={site.registerUrl} target="_blank" rel="noopener noreferrer">
      Register
    </a>
  </nav>
</header>

<script>
  const burger = document.getElementById("burger");
  const menu = document.getElementById("mobile-links");
  burger?.addEventListener("click", () => {
    const open = menu?.classList.toggle("open");
    burger.setAttribute("aria-expanded", String(!!open));
  });
  menu?.querySelectorAll("a").forEach((a) =>
    a.addEventListener("click", () => {
      menu.classList.remove("open");
      burger?.setAttribute("aria-expanded", "false");
    })
  );
</script>

<style>
  .nav {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(10, 13, 18, 0.86);
    backdrop-filter: blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 16px;
    padding-bottom: 16px;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .brand-mark {
    width: 34px;
    height: 34px;
    display: grid;
    place-items: center;
    border: 1px solid var(--teal);
    border-radius: 3px;
    color: var(--teal);
    font-family: var(--font-display);
    font-weight: 700;
  }
  .brand-text {
    font-family: var(--font-display);
    font-weight: 700;
    font-size: 1.15rem;
    letter-spacing: 0.04em;
  }
  .brand-year {
    color: var(--teal);
    margin-left: 4px;
  }
  .links {
    display: flex;
    gap: 32px;
    font-family: var(--font-mono);
    font-size: 0.82rem;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
  .links a {
    color: var(--text-muted);
    transition: color 0.15s ease;
  }
  .links a:hover { color: var(--teal); }

  .nav-cta { padding: 10px 20px; font-size: 0.78rem; }

  .burger {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 5px;
    width: 34px;
    height: 34px;
    background: none;
    border: 1px solid var(--line-bright);
    border-radius: 3px;
    cursor: pointer;
  }
  .burger span {
    height: 1.5px;
    background: var(--text);
    margin: 0 7px;
    transition: transform 0.2s ease, opacity 0.2s ease;
  }

  .mobile-links {
    display: none;
    flex-direction: column;
    gap: 4px;
    padding: 0 24px 20px;
  }
  .mobile-links a {
    padding: 12px 4px;
    border-bottom: 1px solid var(--line);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    text-transform: uppercase;
    color: var(--text-muted);
  }
  .mobile-links .btn { margin-top: 14px; justify-content: center; }
  .mobile-links.open { display: flex; }

  @media (max-width: 860px) {
    .links, .nav-cta { display: none; }
    .burger { display: flex; }
  }
</style>
