---
import { site } from "../data/site.js";
---

<section id="top" class="hero blueprint-grid">
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">National Level Technical Symposium &amp; Workshop</p>
      <h1>
        YANTRA<span class="year">2K26</span>
      </h1>
      <p class="tagline">{site.tagline}</p>
      <p class="motto">"{site.motto}"</p>

      <div class="cta-row">
        <a class="btn btn-primary" href={site.registerUrl} target="_blank" rel="noopener noreferrer">
          Register now →
        </a>
        <a class="btn btn-ghost" href="#events">View events</a>
      </div>

      <p class="host">
        {site.department} &middot; {site.college}
      </p>
    </div>

    <div class="hero-dial" aria-hidden="true">
      <svg viewBox="0 0 320 320" width="100%" height="100%">
        <circle cx="160" cy="160" r="150" fill="none" stroke="var(--line-bright)" stroke-width="1" />
        <circle cx="160" cy="160" r="120" fill="none" stroke="var(--line)" stroke-width="1" stroke-dasharray="2 6" />
        {[0, 30, 60, 90, 120, 150, 180, 210, 240, 270, 300, 330].map((deg) => (
          <line
            x1="160"
            y1="14"
            x2="160"
            y2={deg % 90 === 0 ? 30 : 24}
            stroke="var(--teal-dim)"
            stroke-width="1.5"
            transform={`rotate(${deg} 160 160)`}
          />
        ))}
        <g class="dial-spin">
          <circle cx="160" cy="160" r="70" fill="none" stroke="var(--teal)" stroke-width="1.5" />
          <circle cx="160" cy="160" r="4" fill="var(--teal)" />
          <line x1="160" y1="160" x2="160" y2="98" stroke="var(--teal)" stroke-width="2" />
        </g>
        <text x="160" y="168" text-anchor="middle" class="dial-label">SEP 25–27</text>
      </svg>
    </div>
  </div>

  <div class="scroll-cue" aria-hidden="true">
    <span></span>
  </div>
</section>

<style>
  .hero {
    padding-top: 88px;
    padding-bottom: 88px;
    border-bottom: 1px solid var(--line);
    position: relative;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 40px;
  }
  .hero-copy h1 {
    font-size: clamp(3.2rem, 9vw, 6rem);
    margin-top: 18px;
    color: var(--text);
  }
  .year {
    color: var(--teal);
    margin-left: 10px;
  }
  .tagline {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.2rem, 2.4vw, 1.6rem);
    color: var(--gold);
    margin-top: 12px;
  }
  .motto {
    margin-top: 18px;
    max-width: 480px;
    color: var(--text-muted);
    font-style: italic;
    font-size: 1rem;
  }
  .cta-row {
    display: flex;
    gap: 16px;
    margin-top: 36px;
    flex-wrap: wrap;
  }
  .host {
    margin-top: 40px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-faint);
    letter-spacing: 0.02em;
  }

  .hero-dial {
    width: min(320px, 100%);
    justify-self: center;
  }
  .dial-spin {
    transform-origin: 160px 160px;
    animation: rotate 18s linear infinite;
  }
  .dial-label {
    font-family: var(--font-mono);
    font-size: 12px;
    fill: var(--text-faint);
    letter-spacing: 0.08em;
  }
  @keyframes rotate {
    to { transform: rotate(360deg); }
  }

  .scroll-cue {
    display: flex;
    justify-content: center;
    margin-top: 64px;
  }
  .scroll-cue span {
    width: 1px;
    height: 44px;
    background: linear-gradient(var(--teal), transparent);
    display: block;
  }

  @media (max-width: 860px) {
    .hero-inner { grid-template-columns: 1fr; text-align: center; }
    .hero-copy { order: 2; }
    .cta-row, .host { justify-content: center; }
    .cta-row { justify-content: center; }
    .hero-dial { width: 220px; margin: 0 auto; }
    .motto { margin-left: auto; margin-right: auto; }
  }
</style>
