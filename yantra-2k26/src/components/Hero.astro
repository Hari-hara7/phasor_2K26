---
import { site } from "../data/site.js";
---

<section id="top" class="hero blueprint-grid">
  <div class="wrap hero-inner">
    <div class="hero-copy">
      <p class="eyebrow">National Level Technical Symposium &amp; Workshop</p>
      <h1>
        PHASOR<span class="year">2K26</span>
      </h1>
      <p class="tagline">{site.tagline}</p>
      <p class="motto">"{site.motto}"</p>

      <div class="cta-row">
        <a class="btn btn-primary" href={site.registerUrl} target="_blank" rel="noopener noreferrer">
          Register now ->
        </a>
        <a class="btn btn-ghost" href="#events">View events</a>
      </div>

      <p class="host">
        {site.department} &middot; {site.college} &middot; {site.dates}
      </p>
    </div>

    <div class="hero-dial" aria-hidden="true">
      <svg viewBox="0 0 320 320" width="100%" height="100%">
        <circle cx="160" cy="160" r="148" fill="none" stroke="var(--line-bright)" stroke-width="1" />
        <circle cx="160" cy="160" r="104" fill="none" stroke="var(--teal-dim)" stroke-width="1" stroke-dasharray="6 10" />
        <path d="M32 160 H102 L122 126 L150 202 L180 88 L206 160 H288" fill="none" stroke="var(--gold)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
        <path d="M86 84 H132 V52 H184 V84 H234 M86 236 H132 V268 H184 V236 H234" fill="none" stroke="var(--line-bright)" stroke-width="2" stroke-linecap="round" />
        <g class="dial-pulse">
          <circle cx="160" cy="160" r="42" fill="none" stroke="var(--teal)" stroke-width="2" />
          <circle cx="160" cy="160" r="8" fill="var(--teal)" />
          <path d="M160 118 V202 M118 160 H202" stroke="var(--teal)" stroke-width="2" stroke-linecap="round" />
        </g>
        <text x="160" y="292" text-anchor="middle" class="dial-label">OCT 6 - 8</text>
      </svg>
    </div>
  </div>

  <div class="scroll-cue" aria-hidden="true">
    <span></span>
  </div>
</section>

<style>
  .hero {
    padding-top: 88px;
    padding-bottom: 88px;
    border-bottom: 1px solid var(--line);
    position: relative;
    overflow: hidden;
  }
  .hero::before {
    content: "";
    position: absolute;
    inset: 0;
    background:
      radial-gradient(circle at 72% 44%, rgba(0, 194, 255, 0.2), transparent 28%),
      linear-gradient(120deg, rgba(243, 209, 112, 0.08), transparent 40%);
    pointer-events: none;
  }
  .hero-inner {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    align-items: center;
    gap: 40px;
    position: relative;
    z-index: 1;
  }
  .hero-copy h1 {
    font-size: clamp(3.2rem, 9vw, 6rem);
    margin-top: 18px;
    color: var(--text);
  }
  .year {
    color: var(--teal);
    margin-left: 10px;
  }
  .tagline {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: clamp(1.2rem, 2.4vw, 1.6rem);
    color: var(--gold);
    margin-top: 12px;
  }
  .motto {
    margin-top: 18px;
    max-width: 560px;
    color: var(--text-muted);
    font-style: italic;
    font-size: 1rem;
  }
  .cta-row {
    display: flex;
    gap: 16px;
    margin-top: 36px;
    flex-wrap: wrap;
  }
  .host {
    margin-top: 40px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--text-faint);
    letter-spacing: 0.02em;
  }

  .hero-dial {
    width: min(320px, 100%);
    justify-self: center;
    filter: drop-shadow(0 0 22px rgba(0, 194, 255, 0.22));
  }
  .dial-pulse {
    transform-origin: 160px 160px;
    animation: pulse 2.4s ease-in-out infinite;
  }
  .dial-label {
    font-family: var(--font-mono);
    font-size: 12px;
    fill: var(--text-faint);
    letter-spacing: 0.08em;
  }
  @keyframes pulse {
    50% { transform: scale(1.06); opacity: 0.72; }
  }

  .scroll-cue {
    display: flex;
    justify-content: center;
    margin-top: 64px;
    position: relative;
    z-index: 1;
  }
  .scroll-cue span {
    width: 1px;
    height: 44px;
    background: linear-gradient(var(--teal), transparent);
    display: block;
  }

  @media (max-width: 860px) {
    .hero-inner { grid-template-columns: 1fr; text-align: center; }
    .hero-copy { order: 2; }
    .cta-row, .host { justify-content: center; }
    .hero-dial { width: 220px; margin: 0 auto; }
    .motto { margin-left: auto; margin-right: auto; }
  }
</style>
